{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:*",
        "acm:*",
        "airflow:*",
        "aoss:*",
        "apigateway:*",
        "application-autoscaling:*",
        "athena:*",
        "aws-marketplace:*",
        "bedrock:*",
        "cloudformation:*",
        "cloudwatch:*",
        "codecommit:*",
        "cloudtrail:*",
        "datazone:*",
        "dbqms:*",
        "dms:*",
        "ds:*",
        "dynamodb:*",
        "ec2:*",
        "eks:*",
        "elasticmapreduce:*",
        "elasticloadbalancing:*",
        "emr-serverless:*",
        "events:*",
        "fsx:*",
        "glue:*",
        "iam:AttachRolePolicy",
        "iam:CreatePolicy",
        "iam:CreateRole",
        "iam:CreateSAMLProvider",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:Get*",
        "iam:List*",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:TagRole",
        "identitystore:*",
        "kinesis:*",
        "kms:*",
        "lakeformation:*",
        "lambda:*",
        "logs:*",
        "pi:*",
        "quicksight:*",
        "ram:*",
        "rds-data:*",
        "rds:*",
        "redshift-data:*",
        "redshift-serverless:*",
        "redshift:*",
        "s3:*",
        "s3tables:*",
        "sagemaker-mlflow:*",
        "sagemaker:*",
        "secretsmanager:*",
        "serverlessrepo:*",
        "serviceCatalog:*",
        "sns:*",
        "sqlworkbench:*",
        "sqs:*",
        "ssm-guiconnect:*",
        "ssm:*",
        "sso-directory:*",
        "sso:*",
        "sts:AssumeRole",
        "sts:GetCallerIdentity",
        "sts:SetSourceIdentity",
        "sts:TagSession",
        "tag:*",
        "cloudshell:*"
      ],
      "Resource": ["*"]
    },
    {
      "Sid": "Statement1",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": ["*"],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
